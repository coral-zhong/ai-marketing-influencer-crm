# Feishu / Lark
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional if the agent parses an existing Base URL or creates a new Base.
FEISHU_BASE_TOKEN=
FEISHU_CREATORS_TABLE_ID=
# Auto-filled by npm run setup:feishu for full template installs.
FEISHU_TABLES_JSON=
FEISHU_OAUTH_REDIRECT_URI=
FEISHU_OAUTH_SCOPES=bitable:app:readonly
FEISHU_OAUTH_EXPECTED_STATE=

# Agent service
# Local endpoint secret. Not a Feishu credential; generate any private random string.
AGENT_API_SECRET=
AGENT_PORT=3215
AGENT_DEMO_MODE=true

# LLM provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
